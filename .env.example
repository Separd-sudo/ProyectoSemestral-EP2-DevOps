# ============================================================
# Este archivo es un ejemplo. No debe contener credenciales reales.
# ============================================================

# ------------------------------------------------------------
# Base de datos Ventas
# ------------------------------------------------------------
POSTGRES_VENTAS_DB=ventas_db
POSTGRES_VENTAS_USER=postgres
POSTGRES_VENTAS_PASSWORD=postgres
POSTGRES_VENTAS_PORT=5433

# ------------------------------------------------------------
# Base de datos Despachos
# ------------------------------------------------------------
POSTGRES_DESPACHOS_DB=despachos_db
POSTGRES_DESPACHOS_USER=postgres
POSTGRES_DESPACHOS_PASSWORD=postgres
POSTGRES_DESPACHOS_PORT=5434

# ------------------------------------------------------------
# Backend Ventas - Spring Boot
# ------------------------------------------------------------
BACKEND_VENTAS_PORT=8081
SPRING_DATASOURCE_VENTAS_URL=jdbc:postgresql://postgres-ventas:5432/ventas_db
SPRING_DATASOURCE_VENTAS_USERNAME=postgres
SPRING_DATASOURCE_VENTAS_PASSWORD=postgres

# ------------------------------------------------------------
# Backend Despachos - Spring Boot
# ------------------------------------------------------------
BACKEND_DESPACHOS_PORT=8082
SPRING_DATASOURCE_DESPACHOS_URL=jdbc:postgresql://postgres-despachos:5432/despachos_db
SPRING_DATASOURCE_DESPACHOS_USERNAME=postgres
SPRING_DATASOURCE_DESPACHOS_PASSWORD=postgres

# ------------------------------------------------------------
# Frontend React/Vite
# ------------------------------------------------------------
FRONTEND_PORT=80

# URL local de los backends
VITE_API_VENTAS_URL=http://localhost:8081
VITE_API_DESPACHOS_URL=http://localhost:8082

# URL futura para despliegue en AWS
# VITE_API_VENTAS_URL=http://IP_BACKEND:8081
# VITE_API_DESPACHOS_URL=http://IP_BACKEND:8082